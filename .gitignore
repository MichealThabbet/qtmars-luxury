* {
  box-sizing: border-box;
}

:root {
  --bg: #060b18;
  --bg-2: #0d1324;
  --panel: rgba(14, 21, 38, 0.82);
  --panel-border: rgba(255, 255, 255, 0.08);
  --soft-text: #b9c2d7;
  --strong-text: #edf5ff;
  --gold: #d7b773;
  --gold-strong: #f5d48a;
  --cyan: #8ad9ff;
  --rose: #f290af;
  --success: #7ae8c1;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 100%;
  font-family: 'Cairo', sans-serif;
  color: var(--strong-text);
  background:
    radial-gradient(circle at top left, rgba(215, 183, 115, 0.14), transparent 30%),
    linear-gradient(180deg, #050a16 0%, #0d1324 100%);
}

body {
  min-height: 100vh;
}

button, input {
  font: inherit;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 32px 20px;
  overflow: hidden;
}

.bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.32;
}

.glow-one {
  top: 60px;
  left: 12%;
  width: 280px;
  height: 280px;
  background: rgba(215, 183, 115, 0.35);
}

.glow-two {
  right: 14%;
  bottom: 42px;
  width: 330px;
  height: 330px;
  background: rgba(138, 217, 255, 0.22);
}

.app-frame {
  position: relative;
  z-index: 1;
  max-width: 1180px;
  margin: 0 auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 22px;
}

.kicker {
  margin: 0;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 11px;
  color: var(--gold-strong);
}

.kicker.small {
  font-size: 10px;
}

h1 {
  margin: 6px 0 0;
  font-size: clamp(2.4rem, 4vw, 4rem);
  line-height: 1.1;
}

.ghost-button {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  color: var(--strong-text);
  padding: 12px 18px;
  border-radius: 12px;
  cursor: pointer;
  transition: 0.2s ease;
}

.ghost-button:hover {
  background: rgba(255, 255, 255, 0.05);
}

.content-grid {
  display: grid;
  grid-template-columns: 1.7fr 0.9fr;
  gap: 18px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 24px;
  backdrop-filter: blur(12px);
  box-shadow: 0 30px 70px rgba(4, 8, 18, 0.4);
}

.hero {
  display: grid;
  grid-template-columns: 1.6fr 0.8fr;
  gap: 22px;
  padding: 26px;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.badge {
  display: inline-flex;
  width: fit-content;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(215, 183, 115, 0.12);
  border: 1px solid rgba(215, 183, 115, 0.2);
  color: var(--gold-strong);
  font-size: 12px;
  font-weight: 700;
}

.hero h2 {
  margin: 14px 0 12px;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.3;
}

.hero p {
  margin: 0;
  color: var(--soft-text);
  line-height: 1.9;
  font-size: 1rem;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}

.meta-pill {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 12px 14px;
  color: var(--soft-text);
  font-size: 13px;
}

.meta-pill strong {
  color: var(--strong-text);
}

.mini-calendar {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 18px 14px;
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(215, 183, 115, 0.08), rgba(138, 217, 255, 0.03));
  border: 1px solid rgba(215, 183, 115, 0.18);
}

.mini-label {
  color: var(--gold-strong);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.mini-date {
  font-size: clamp(3rem, 5vw, 4rem);
  font-weight: 800;
  margin-top: 14px;
  line-height: 1;
}

.mini-month {
  margin-top: 10px;
  color: var(--soft-text);
}

.mini-year {
  margin-top: 4px;
  font-weight: 700;
  color: var(--gold-strong);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(120px, 1fr));
  gap: 18px;
}

.stat-card {
  padding: 18px 20px;
}

.stat-card span {
  display: block;
  color: var(--soft-text);
  margin-bottom: 10px;
  font-size: 13px;
}

.stat-card strong {
  font-size: clamp(1.2rem, 2vw, 1.7rem);
}

.main-panel {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1.5fr 0.8fr;
  gap: 18px;
}

.reading-card, .side-card, .planner-card, .selector-card {
  padding: 22px 20px;
}

.section-head,
.planner-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.section-head h3,
.planner-head h3 {
  margin: 0;
  font-size: 1.2rem;
}

.dot {
  width: 10px;
  height: 10px;
  display: inline-block;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 16px rgba(215, 183, 115, 0.8);
}

.reading-subtitle {
  margin: 0 0 10px;
  color: var(--gold-strong);
  font-weight: 700;
}

.reading-body p {
  color: var(--soft-text);
  line-height: 1.9;
  margin: 0 0 12px;
}

.reading-body blockquote {
  margin: 16px 0 0;
  padding: 16px 18px;
  border-right: 3px solid var(--gold);
  background: rgba(255, 255, 255, 0.02);
  color: var(--strong-text);
  border-radius: 12px;
}

.detail-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 14px;
}

.detail-list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  color: var(--soft-text);
}

.detail-list li strong {
  color: var(--strong-text);
  font-size: 0.96rem;
}

.planner-card {
  grid-column: 1 / -1;
}

.pill {
  background: rgba(122, 232, 193, 0.12);
  color: var(--success);
  font-weight: 700;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(122, 232, 193, 0.3);
}

.progress-track {
  width: 100%;
  height: 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.06);
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--gold), var(--cyan));
}

.week-list {
  margin-top: 18px;
  display: grid;
  gap: 12px;
}

.week-item {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 14px 16px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255,255,255,0.06);
}

.week-item strong {
  font-size: 0.96rem;
}

.week-item span {
  color: var(--soft-text);
}

.selector-card input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.02);
  color: var(--strong-text);
}

@media (max-width: 900px) {
  .content-grid,
  .main-panel,
  .hero {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .page-shell {
    padding: 18px 14px;
  }

  .topbar {
    align-items: flex-start;
  }

  .hero,
  .reading-card,
  .side-card,
  .planner-card,
  .selector-card,
  .stat-card {
    padding: 18px 16px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }
}
